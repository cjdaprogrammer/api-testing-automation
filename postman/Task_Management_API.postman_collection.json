{
  "info": {
    "name": "Task Management API",
    "description": "Postman collection for functional, positive, negative, and boundary API testing of the Task Management API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Health status is healthy', function () { pm.expect(pm.response.json().status).to.eql('healthy'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test task from Postman\",\n  \"description\": \"Created during API testing\",\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
              "pm.test('Response contains expected task fields', function () {",
              "    const task = pm.response.json();",
              "    pm.expect(task).to.have.property('id');",
              "    pm.expect(task.title).to.eql('Test task from Postman');",
              "    pm.expect(task.description).to.eql('Created during API testing');",
              "    pm.expect(task.completed).to.eql(false);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('taskId', String(pm.response.json().id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Get All Tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
              "pm.test('Created task appears in the list', function () {",
              "    const tasks = pm.response.json();",
              "    const taskId = Number(pm.collectionVariables.get('taskId'));",
              "    pm.expect(tasks.some(task => task.id === taskId)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Get Task by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returned task ID matches requested ID', function () {",
              "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('taskId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Update Task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated task from Postman\",\n  \"description\": \"Updated during API testing\",\n  \"completed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Task fields were updated', function () {",
              "    const task = pm.response.json();",
              "    pm.expect(task.title).to.eql('Updated task from Postman');",
              "    pm.expect(task.description).to.eql('Updated during API testing');",
              "    pm.expect(task.completed).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Delete Task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Deletion confirmation is returned', function () {",
              "    pm.expect(pm.response.json().message).to.eql('Task deleted successfully');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Verify Deleted Task Returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted task returns 404 Not Found', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Get Nonexistent Task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Error message is correct', function () {",
              "    pm.expect(pm.response.json().detail).to.eql('Task not found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Reject Empty Title",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"description\": \"Invalid empty title\",\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Empty title returns 422', function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    },
